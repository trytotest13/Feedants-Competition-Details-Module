# Feedants Competition Module — environment variables (NAMES ONLY, never real values)
#
# Backend copies its own file:  cp backend/.env.example backend/.env
# Mobile copies its own file:   cp mobile/.env.example  mobile/.env
# See docs/trd.md for full documentation of each variable.

# ── backend/.env ─────────────────────────────────────
# NODE_ENV=development
# PORT=4000
# MONGODB_URI=                # leave empty in dev to use isolated in-memory MongoDB
# JWT_SECRET=
# JWT_EXPIRES_IN=7d
# CORS_ORIGINS=*
# PAYMENT_MODE=mock           # mock | razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# UPLOAD_DIR=uploads
# MAX_UPLOAD_MB=50
# ALLOW_DB_FALLBACK=true

# ── mobile/.env ──────────────────────────────────────
# EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
