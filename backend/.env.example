# ── Feedants backend — copy to .env and fill in (NEVER commit .env) ──
NODE_ENV=development
PORT=4000

# Leave MONGODB_URI empty in development to auto-start an isolated in-memory MongoDB.
# Production: mongodb+srv://<user>:<password>@<cluster>/<db>
MONGODB_URI=

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated allow-list, or * for development only
CORS_ORIGINS=*

# mock → entry fee auto-confirms (Expo Go demo). razorpay → real order + webhook flow.
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Absolute base URL used to build media links returned by the API
PUBLIC_BASE_URL=http://localhost:4000

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

# When true and MONGODB_URI is empty, dev server boots an in-memory MongoDB
ALLOW_DB_FALLBACK=true

# Reward credited to a referrer per successful referred signup (₹)
REFERRAL_REWARD_AMOUNT=10
